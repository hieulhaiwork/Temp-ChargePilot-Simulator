# Biến môi trường của web ChargePilot. Chép sang .env.local để chạy trên máy.
# Mọi biến NEXT_PUBLIC_* nằm trong bundle gửi cho trình duyệt — KHÔNG đặt secret ở đây.

# Gốc REST của backend (không có /api/v1). Trên Vercel: URL của dịch vụ Render.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gốc WebSocket. Bỏ trống thì suy từ NEXT_PUBLIC_API_URL (http → ws, https → wss).
# Trình duyệt nối THẲNG tới backend, không đi qua Vercel.
NEXT_PUBLIC_WS_URL=
