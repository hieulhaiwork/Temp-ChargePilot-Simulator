+        planned_minutes=15,
+        closed=True,
+        closed_after_minutes=0,
+        schedule_version=1,
+        booking_kw_samples=[],
+    )
+    t0b = _synthetic_trace(
+        "t-0b",
+        T0,
+        minute=0,
+        planned_minutes=15,
+        closed=True,
+        closed_after_minutes=4,
+        schedule_version=2,
+        policy_id="B0",
+        booking_kw_samples=[(m, {"b-a": 12.0}) for m in range(4)],
+    )
+    t1 = _synthetic_trace(
