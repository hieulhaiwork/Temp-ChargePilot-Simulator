+async def test_planned_facts_build_failure_is_isolated_from_control_loop(monkeypatch):
+    b_dc = _make_booking("dc-1", zone="DC", kwh=30, hours=1.5)
+    rt = await _sim_station(StrategyName.SIM_M3A, [b_dc])
+
+    def boom(*_, **__):
