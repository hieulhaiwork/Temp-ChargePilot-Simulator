+
+async def seed_demo():
+    rt = _rt()
+    rt.store = replace(rt.store, save_trace=decision_trace.persist)
+    _add(rt, "private-holder-a")
+    _add(rt, "private-holder-b")
+    own = _add(rt, "resident-demo", hours=2)
+    own.request.soc_target = 90
