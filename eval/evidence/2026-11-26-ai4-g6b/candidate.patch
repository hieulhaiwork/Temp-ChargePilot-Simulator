+  expect(fetchSpy).not.toHaveBeenCalled();
+
+  // 2) Pending getUserMedia resolving after session change -> late track stopped immediately
+  fireEvent.click(screen.getByRole("button", { name: "Nói bằng giọng tiếng Việt" }));
+  act(() => {
+    clearSession();
+  });
+  await act(async () => {
