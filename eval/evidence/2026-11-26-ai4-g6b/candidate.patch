+it("isolates WebSocket useStream across session generations and ignores stale close codes", async () => {
+  const sockets: Array<{
+    url: string;
+    closed: boolean;
+    onopen: (() => void) | null;
+    onclose: ((ev: { code: number; reason: string }) => void) | null;
