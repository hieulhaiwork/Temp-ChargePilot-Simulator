+@pytest.mark.parametrize("window", ["trace", "record", "notify", "cancel", "power_emergency"])
+async def test_remediation_hard_event_survives_failure_window(live, monkeypatch, window):
+    rt, clock = live
+    await _charging_live(rt)
+    rt.deliver = None
+    sim = rt.simulator
+    sim.available_power_kw = SILENT_LIMIT_KW
+    clock["now"] += timedelta(minutes=4)
+    event = StationEvent(
+        type=EventType.POWER_LIMIT_CHANGED if window == "power_emergency" else EventType.TICK,
+        occurred_at=rt.clock(),
+        new_power_limit_kw=SILENT_LIMIT_KW if window == "power_emergency" else None,
+    )
+
+    def fail(*_):
+        raise RuntimeError("synthetic failure window")
+
+    async def fail_async(*_):
+        if window == "cancel":
+            raise asyncio.CancelledError()
+        fail()
+
+    from src.services import decision_trace
+
+    with monkeypatch.context() as patch:
+        if window == "trace":
+            patch.setattr(decision_trace, "close_open", fail)
+        elif window == "record":
+            patch.setattr(rt.store, "record_event", fail)
+        elif window == "power_emergency":
+            patch.setattr(control_loop, "_emergency", fail_async)
+        else:
+            patch.setattr(rt, "sinks", dataclasses.replace(rt.sinks, notify=fail_async))
+        try:
+            await control_loop.on_event(event, rt)
+        except (RuntimeError, asyncio.CancelledError):
+            pass
+
+    assert _emergency_decisions() or any(e.type == EventType.HARD_LIMIT_VIOLATED for e in rt.outbox)
+    await control_loop.deliver_pending(rt)
+    rt.sync_clock()
+    assert sim.minute == 4
+    assert _emergency_decisions()
+
