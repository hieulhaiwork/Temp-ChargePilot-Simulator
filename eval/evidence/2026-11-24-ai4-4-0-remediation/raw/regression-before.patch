+@pytest.mark.parametrize("failure", ["construction", "serialization"])
+async def test_remediation_trace_construction_failure_keeps_failsafe_and_violation(live, monkeypatch, caplog, failure):
+    from src.services import decision_trace
+
+    rt, clock = live
+    await _charging_live(rt)
+    cid = rt.open_trace["trace"]["correlation_id"]
+    rt.simulator.available_power_kw = SILENT_LIMIT_KW
+    clock["now"] += timedelta(minutes=4)
+
+    original = rt.simulator.decision_facts
+
+    def fail(*args, **kwargs):
+        if failure == "construction":
+            raise ValueError("synthetic evidence construction failure")
+        return {**original(*args, **kwargs), "invalid": float("nan")}
+
+    monkeypatch.setattr(rt.simulator, "decision_facts", fail)
+    await control_loop.on_event(StationEvent(type=EventType.TICK, occurred_at=rt.clock()), rt)
+    assert _emergency_decisions()
+    trace = repository.get_full_decision_trace(cid)
+    assert trace["validation"]["post_apply"] == "violation"
+    assert trace["decision"] is None
+    assert trace["applied"]["hard_violations"]
+    assert "decision_trace_build_failed" in caplog.text
+    decision_trace.close_open(rt)
+
