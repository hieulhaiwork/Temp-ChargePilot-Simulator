+@pytest.mark.parametrize("has_violation", [False, True])
+async def test_remediation_sample_eviction_does_not_report_complete_pass(has_violation):
+    from collections import deque
+
+    from src.services import decision_trace
+
+    rt = await _sim_runtime(failsafe=True)
+    sim = rt.simulator
+    sim._applied = deque(maxlen=1)
+    if has_violation:
+        sim.available_power_kw = SILENT_LIMIT_KW
+    sim.step(1)
+    sim.available_power_kw = rt.config.grid_input_limit_kw
+    sim.step(1)
+    trace = decision_trace.close_open(rt)
+    assert trace["applied"]["coverage"]["dropped_minutes"] == 1
+    assert trace["applied"]["coverage"]["status"] == "incomplete"
+    assert trace["validation"]["post_apply"] == ("violation" if has_violation else "incomplete")
+
