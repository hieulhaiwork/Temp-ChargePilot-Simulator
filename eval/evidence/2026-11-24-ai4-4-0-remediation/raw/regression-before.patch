+    from src.models.control import Approval, ApprovalKind, Command, GuardVerdict
+
+    rt, _ = live
+    await _charging_live(rt)
+    sim = rt.simulator
+    connector = next(c for c in sim.state().connectors if c.booking_id == "dc-a")
+    command = Command(
+        type=CommandType(operation),
+        connector_id=connector.connector_id,
+        power_kw=40 if operation == "set_power" else None,
+        booking_id="dc-a",
+        source=CommandSource.AGENT,
+        issued_by="synthetic",
+        based_on_schedule_version=rt.plan.version,
+        based_on_state_at=rt.clock(),
+        created_at=rt.clock(),
+    )
+    approval = Approval(
+        kind=ApprovalKind.OPERATOR_REVIEW,
+        command=command,
+        verdict=GuardVerdict(command_id=command.command_id, passed=True, checked_at=rt.clock()),
+        requested_from="operator",
+        impact_summary="synthetic approval",
+        created_at=rt.clock(),
+    )
+    repository.save_approval(approval)
+    await _trip_charging_model(rt)
+    assert "dc-a" in rt.safety_hold_booking_ids
+    if operation == "assign_connector":
+        from src.models.simulation import Incident, IncidentType
+
+        sim.inject_incident(Incident(type=IncidentType.CONNECTOR_FAULT, connector_id=connector.connector_id))
+        sim.inject_incident(Incident(type=IncidentType.CONNECTOR_RESTORED, connector_id=connector.connector_id))
+        assert "dc-a" in sim.state().queue
+    await control_loop.resolve_approval(approval.approval_id, "approve", "operator", rt, Role.OPERATOR)
+    decisions = [d for d in repository.list_decisions() if d.approval_id == approval.approval_id]
+    assert len(decisions) == 1 and not decisions[0].executed
+    assert sim.kernel.setpoints.get("dc-a", 0) == 0
