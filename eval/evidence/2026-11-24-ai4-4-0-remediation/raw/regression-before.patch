+async def test_remediation_cancellation_during_dispatch_preserves_hard_event(live, monkeypatch):
+    from src.guard import dispatcher
+
+    rt, clock = live
+    await _charging_live(rt)
+    rt.deliver = None
+    rt.simulator.available_power_kw = SILENT_LIMIT_KW
+    clock["now"] += timedelta(minutes=4)
+    (hard,) = [e for e in rt.sync_clock() if e.type == EventType.HARD_LIMIT_VIOLATED]
+    entered = asyncio.Event()
+
+    async def pause(*_, **__):
+        entered.set()
+        await asyncio.Future()
+
+    with monkeypatch.context() as patch:
+        patch.setattr(dispatcher, "submit", pause)
+        task = asyncio.create_task(control_loop.deliver_pending(rt))
+        await asyncio.wait_for(entered.wait(), 2)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+    assert hard in rt.outbox and rt.simulator.minute == 1
+    await control_loop.deliver_pending(rt)
+    assert rt.simulator.minute == 4 and hard not in rt.outbox
