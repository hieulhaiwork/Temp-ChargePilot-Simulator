+class StatefulDC:
+    def __init__(self, delegate):
+        self.delegate = delegate
+        self.calls = 0
+
+    def acceptance_kw(self, *args):
+        self.calls += 1
+        return self.delegate.acceptance_kw(*args)
+
+    def stored_kwh(self, *args):
+        self.calls += 1
+        return self.delegate.stored_kwh(*args)
+
