+@pytest.mark.parametrize("response", ["blocked", "partial", "pending", "no_commands"])
+async def test_remediation_unsafe_failsafe_dispatch_does_not_acknowledge(live, monkeypatch, response):
+    from src.guard import dispatcher
+    from src.models.control import DecisionLogEntry, GuardRule, GuardVerdict, Violation
+
+    rt, clock = live
+    await _charging_live(rt)
+    rt.deliver = None
+    sim = rt.simulator
+    sim.available_power_kw = SILENT_LIMIT_KW
+    clock["now"] += timedelta(minutes=4)
+    (hard,) = [e for e in rt.sync_clock() if e.type == EventType.HARD_LIMIT_VIOLATED]
+    minute = sim.minute
+    original = dispatcher.submit
+    attempts = 0
+
+    async def submit(commands, ctx, actuator, sinks, **kwargs):
+        nonlocal attempts
+        if not commands or commands[0].source != CommandSource.EMERGENCY:
+            return await original(commands, ctx, actuator, sinks, **kwargs)
+        attempts += 1
+        applied = await original(commands[:1], ctx, actuator, sinks, **kwargs) if response == "partial" else []
+        remaining = commands[1:] if response == "partial" else commands
+        return [
+            *applied,
+            *[
+                DecisionLogEntry(
+                    timestamp=ctx.now,
+                    command=cmd,
+                    verdict=GuardVerdict(
+                        command_id=cmd.command_id,
+                        checked_at=ctx.now,
+                        passed=response == "pending",
+                        violations=[]
+                        if response == "pending"
+                        else [Violation(rule=GuardRule.PERMISSION, detail="synthetic block")],
+                    ),
+                    approval_id="synthetic-pending" if response == "pending" else None,
+                    executed=False,
+                )
+                for cmd in remaining
+            ],
+        ]
+
+    with monkeypatch.context() as patch:
+        if response == "no_commands":
+            patch.setattr(emergency, "curtail_to_hard_limits", lambda *_: [])
+        else:
+            patch.setattr(dispatcher, "submit", submit)
+        for _ in range(5):
+            await control_loop.deliver_pending(rt)
+            assert hard in rt.outbox
+            assert rt.sync_clock() == [] and sim.minute == minute
+        if response != "no_commands":
+            assert attempts == 3
+    sim.available_power_kw = rt.config.grid_input_limit_kw
+    await control_loop.deliver_pending(rt)
+    assert hard not in rt.outbox
+    assert sim.minute == 4
+
