+            if key in ("_profiles", "profiles", "unresolved", "rng", "inner", "delegate", "fallback"):
+                continue
+            attrs[key] = repr(value)
+        if attrs:
+            payload["attrs"] = attrs
+    for nested_name in ("inner", "delegate", "fallback"):
+        nested = getattr(component, nested_name, None)
+        if nested is not None:
