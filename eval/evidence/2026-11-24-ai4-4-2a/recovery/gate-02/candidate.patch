+        limits = self.kernel.effective_limits(minute=minute)
+        return float(limits.grid_input_kw)
+
+    @_locked
+    def enforce_known_at_on_fork(self, as_of_minute: int, known_booking_ids: frozenset[str]) -> dict[str, int]:
