+            self.kernel.scenario = replace(
+                self.kernel.scenario,
+                vehicles=kept_vehicles,
+                limit_events=known_events,
+            )
+        return {
+            "pruned_future_vehicles": pruned_vehicles,
+            "pruned_unannounced_limit_events": pruned_events,
+        }
