+        "min_target_soc": low,
+        "max_target_soc": high,
+        "allow_lower_target": False,
+        "allow_later_deadline": False,
+        "allow_subject_original_sla_regression": False,
+        **changes,
+    }
+
+
+def _earliest(rt, low, high, **changes):
