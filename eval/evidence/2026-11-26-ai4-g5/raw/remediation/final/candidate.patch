+async def test_m3a_dc_deadline_changes_actual_completion_under_contention(minute_samples, record_property):
+    load = (
+        ("a", "DC", 30, 59, 55),
+        ("dc-rival", "DC", 30, 65, 30),
+        ("ac-a", "AC", 30, 35, 36),
+        ("ac-b", "AC", 40, 42, 28),
