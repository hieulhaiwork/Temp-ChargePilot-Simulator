# ============================================
# ChargePilot — biến môi trường của backend
# ============================================
# Chép file này thành .env rồi điền giá trị. KHÔNG BAO GIỜ commit .env.
# File này chỉ chứa TÊN biến và giá trị mẫu an toàn — không có secret thật.
# Danh sách đầy đủ + nơi đặt trên hosting: docs/plan/50-devops.md §6.

# ---- LLM (cascade router — src/services/llm.py) ----
# Chọn nhà cung cấp: openai (API) | local (Ollama/vLLM trên VM) | mock (luật cố định, không cần mạng/key)
LLM_PROVIDER=openai
# ĐỂ TRỐNG khi chưa có key: test, eval offline và phần không dùng LLM vẫn chạy.
# Đừng đặt chuỗi giả (vd "sk-your-key-here"): code coi mọi chuỗi không rỗng là key thật và sẽ gọi API.
OPENAI_API_KEY=
# Model rẻ cho bước reason/routing; model cho câu trả lời cuối; judge PHẢI khác MODEL_GENERATE.
# Tên model chốt ở T2.5 theo trang giá hiện hành của nhà cung cấp (docs/plan/30-ai.md §3.8).
MODEL_CLASSIFY=gpt-4o-mini
MODEL_GENERATE=gpt-4o
MODEL_JUDGE=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=20

# Khi LLM_PROVIDER=local (Ollama / vLLM / LM Studio trên VM):
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_JUDGE_MODEL=
LOCAL_LLM_STRUCTURED_METHOD=json_schema

# ---- Agent loop & Dev tools ----
# Số vòng ReAct tối đa trước khi escape hatch -> finalize_with_partial
AGENT_MAX_ITERATIONS=8
# Chỉ bật ở local dev (bị chặn khi APP_ENV=production):
# AGENT_DEMO_SERVICES=true → dùng dịch vụ sạc giả lập trong bộ nhớ (services/charging_demo.py) khi T2.2 còn stub
# AGENT_PLAYGROUND=true    → mở trang chat thử http://localhost:8000/api/v1/dev/agent không cần token
AGENT_DEMO_SERVICES=false
AGENT_PLAYGROUND=false

# ---- Database (ADR-005) ----
# Local: SQLite, không cần cài gì. Schema do Alembic quản lý: `alembic upgrade head`.
DATABASE_URL=sqlite:///./data/app.db
# Deploy: dán nguyên chuỗi kết nối của Neon (postgresql://…?sslmode=require) vào biến này TRÊN DASHBOARD hosting.
# Dùng `docker compose --profile postgres`: đặt thêm POSTGRES_PASSWORD (mật khẩu Postgres local, tự chọn).
# POSTGRES_PASSWORD=

# ---- Đăng nhập 2 vai trò (ADR-006) ----
# Chuỗi ngẫu nhiên ≥ 32 byte, vd: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Khác nhau giữa bản test và production. Bắt buộc ở production khi auth chạy thật (T1.7).
JWT_SECRET=
JWT_TTL_MINUTES=480
# Tài khoản demo, seed lúc khởi động. JSON một dòng:
#   [{"email":"…","password":"…","role":"resident","display_name":"…","vehicle_model":"DEMO-60"},
#    {"email":"…","password":"…","role":"operator","display_name":"…"}]
# Để trống = không seed.
SEED_USERS_JSON=

# ---- ChargePilot ----
# Tham số trạm / xe / biểu giá / kịch bản nằm ở config/*.yaml (không phải ở đây).
# Simulator: ev2gym (ưu tiên) | acnsim (dự phòng) — FR11
SIMULATOR_BACKEND=ev2gym
# Artifact mô hình dự báo F6 (nhỏ, commit trong repo)
FORECAST_MODEL_PATH=src/forecast/artifacts/departure_lgbm.txt
# Vòng nền (bước simulator, TICK → tính lại lịch, hết hạn phê duyệt): trạm tự chạy theo thời gian, không cần request.
# Local để false cho dễ debug; bật true để thử như trên deploy (Render bật true — docs/plan/56).
CONTROL_LOOP_ENABLED=false
# ADR-018 / ADR-019 Phase 3: trạm = kernel simulator (cần ev2gym, `make install`); chỉ còn giá trị `hybrid`
STATION_ENGINE=hybrid
# Policy chạy thật (registry Planning Core): M3a (mặc định) · M3b · M2b · B0. A–D (LP backend) đã bỏ — giá trị cũ bị từ chối
LIVE_STRATEGY=M3a
# 1 = thời gian thật; 60 = 1 phút thật ứng với 1 giờ mô phỏng (để dashboard chuyển động trong buổi demo)
SIM_TIME_SCALE=1

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# Domain của web, phân cách bằng dấu phẩy. Production: domain Vercel chính xác.
CORS_ORIGINS=http://localhost:3000
# Chỉ đặt ở backend TEST để nhận URL preview của Vercel (regex). Production để trống.
CORS_ORIGIN_REGEX=

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Bật ở môi trường deploy; tắt trong test / CI / eval offline để không tốn hạn mức trace.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=p019-dev
LANGCHAIN_API_KEY=

# ---- AI Hook Logging (do ban tổ chức cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend ----
# Biến của web nằm ở frontend/.env.example (NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WS_URL).
